{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Jade",
  "scopeName": "source.jade",
  "fileTypes": ["jde"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#fstring-triple-double" },
    { "include": "#fstring-triple-single" },
    { "include": "#fstring-double" },
    { "include": "#fstring-single" },
    { "include": "#string-triple-double" },
    { "include": "#string-triple-single" },
    { "include": "#string-double" },
    { "include": "#string-single" },
    { "include": "#prompt-member-deref" },
    { "include": "#prompt-deref" },
    { "include": "#exception-catch-typed" },
    { "include": "#decorator" },
    { "include": "#function-declaration" },
    { "include": "#type-declaration" },
    { "include": "#struct-literal" },
    { "include": "#keywords" },
    { "include": "#storage-types" },
    { "include": "#constants" },
    { "include": "#constants-nil" },
    { "include": "#session-variables" },
    { "include": "#numbers" },
    { "include": "#support-functions" },
    { "include": "#closure-params" },
    { "include": "#operators" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.jade",
      "match": "//.*$"
    },

    "escape": {
      "name": "constant.character.escape.jade",
      "match": "\\\\."
    },

    "fstring-interpolation": {
      "comment": "shared {expr} interpolation body for all f-string variants",
      "name": "meta.embedded.line.jade",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.jade" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.jade" }
      },
      "patterns": [{ "include": "$self" }]
    },

    "fstring-triple-double": {
      "comment": "f\"\"\"...{expr}...\"\"\" — must be tried before fstring-double so the closing triple-quote isn't mistaken for an empty string",
      "name": "string.quoted.triple.jade",
      "begin": "f\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        { "include": "#fstring-interpolation" },
        { "include": "#escape" }
      ]
    },

    "fstring-triple-single": {
      "comment": "f'''...{expr}...''' — single-quote triple variant",
      "name": "string.quoted.triple.jade",
      "begin": "f'''",
      "end": "'''",
      "patterns": [
        { "include": "#fstring-interpolation" },
        { "include": "#escape" }
      ]
    },

    "fstring-double": {
      "name": "string.quoted.double.jade",
      "begin": "f\"",
      "end": "\"",
      "patterns": [
        { "include": "#fstring-interpolation" },
        { "include": "#escape" }
      ]
    },

    "fstring-single": {
      "comment": "f'...{expr}...' — single-quote f-strings are equivalent to double-quote ones",
      "name": "string.quoted.single.jade",
      "begin": "f'",
      "end": "'",
      "patterns": [
        { "include": "#fstring-interpolation" },
        { "include": "#escape" }
      ]
    },

    "string-triple-double": {
      "comment": "\"\"\"...\"\"\" multi-line string — must be tried before string-double",
      "name": "string.quoted.triple.jade",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [{ "include": "#escape" }]
    },

    "string-triple-single": {
      "comment": "'''...''' multi-line string — single-quote triple variant",
      "name": "string.quoted.triple.jade",
      "begin": "'''",
      "end": "'''",
      "patterns": [{ "include": "#escape" }]
    },

    "string-double": {
      "name": "string.quoted.double.jade",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "include": "#escape" }]
    },

    "string-single": {
      "comment": "'...' single-quote strings are equivalent to double-quote ones",
      "name": "string.quoted.single.jade",
      "begin": "'",
      "end": "'",
      "patterns": [{ "include": "#escape" }]
    },

    "prompt-member-deref": {
      "comment": "obj~>p — sugar for obj.(?p), a prompt dereference on a member. Mirrors prompt-deref: the ~> gets jade-green, the prompt name gets variable coloring. Listed before prompt-deref and before operators so the name isn't left unstyled and the ~ / > aren't split into bitwise + comparison tokens.",
      "match": "(~>)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.prompt.jade" },
        "2": { "name": "variable.other.jade" }
      }
    },

    "prompt-deref": {
      "comment": "?varname — the ? gets jade-green, the name gets variable coloring",
      "match": "(\\?)([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.prompt.jade" },
        "2": { "name": "variable.other.jade" }
      }
    },

    "exception-catch-typed": {
      "comment": "catch TypeName binding — TypeName gets type coloring; catch-all `catch e` falls through to the plain keyword rule since bindings are lowercase",
      "match": "\\b(catch)\\s+([A-Z][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control.jade" },
        "2": { "name": "entity.name.type.jade" }
      }
    },

    "decorator": {
      "comment": "@name or @ns::name preceding fn/async fn/struct/extend, e.g. `@tools::register`, `@route(on = \"action\")`. Confirmed against jade's own parser_tests.rs (parse_decorators): stacks (one per line), optional (args), positional and `key = value` forms. Ends right before `(` — the argument list itself is left to the normal top-level rules (strings, numbers, operators, nested struct literals all already tokenize correctly there, same as any other call's parens).",
      "begin": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.decorator.jade" },
        "2": { "name": "entity.name.function.decorator.jade" }
      },
      "end": "(?=[^A-Za-z0-9_:\\s]|$)",
      "patterns": [
        {
          "name": "keyword.operator.path.jade",
          "match": "::"
        },
        {
          "name": "entity.name.function.decorator.jade",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },

    "function-declaration": {
      "comment": "fn name( — colors fn as keyword and name as function entity",
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "keyword.declaration.jade" },
        "2": { "name": "entity.name.function.jade" }
      }
    },

    "type-declaration": {
      "patterns": [
        {
          "comment": "struct Name / interface Name",
          "match": "\\b(struct|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.jade" },
            "2": { "name": "entity.name.type.jade" }
          }
        },
        {
          "comment": "extend Name / extend Name: Interface",
          "match": "\\b(extend)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*:\\s*([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.jade" },
            "2": { "name": "entity.name.type.jade" },
            "3": { "name": "entity.other.inherited-class.jade" }
          }
        }
      ]
    },

    "struct-literal": {
      "comment": "TypeName { ... } struct instantiation — highlights the type name at the call site, e.g. `Point { x: 10 }`",
      "match": "\\b([A-Z][A-Za-z0-9_]*)\\b(?=\\s*\\{)",
      "captures": {
        "1": { "name": "entity.name.type.jade" }
      }
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.jade",
          "match": "\\b(if|elif|else|while|for|in|return|try|catch|raise|await)\\b"
        },
        {
          "name": "keyword.declaration.jade",
          "match": "\\b(let|fn|struct|extend|interface|use|async|from|as)\\b"
        },
        {
          "comment": "prompt keyword — same jade-green scope as ?deref",
          "name": "keyword.other.prompt.jade",
          "match": "\\bprompt\\b"
        },
        {
          "name": "keyword.other.jade",
          "match": "\\bself\\b"
        }
      ]
    },

    "storage-types": {
      "comment": "primitive types used in typed prompts and interface signatures",
      "name": "storage.type.jade",
      "match": "\\b(int|float|bool|str)\\b"
    },

    "constants": {
      "name": "constant.language.boolean.jade",
      "match": "\\b(true|false)\\b"
    },

    "constants-nil": {
      "comment": "nil, None, and null are interchangeable spellings of the same absence-of-value literal",
      "name": "constant.language.null.jade",
      "match": "\\b(nil|None|null)\\b"
    },

    "session-variables": {
      "comment": "read-only-by-convention globals pre-populated by the runtime: __tokens__, __model__, __max_retries__, __retry_log__",
      "name": "variable.language.jade",
      "match": "\\b__[a-zA-Z_]+__\\b"
    },

    "numbers": {
      "patterns": [
        {
          "comment": "binary integer literal — must precede the generic integer rule so 0b1010 isn't split into 0 + b1010",
          "name": "constant.numeric.integer.jade",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.jade",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.jade",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "support-functions": {
      "name": "support.function.builtin.jade",
      "match": "\\b(print|len|write|input)\\b(?=\\s*\\()"
    },

    "closure-params": {
      "comment": "Matches |x, y| closure params. Lookbehind excludes alnum/]/)/| to avoid bitwise |. Lookahead requires the content starts with a letter (not a space), filtering out bitwise `a | b | c` chains.",
      "begin": "(?<![a-zA-Z0-9_])\\|(?=[a-zA-Z_][a-zA-Z0-9_,\\s]*\\|)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.parameters.begin.jade" }
      },
      "end": "\\|",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.jade" }
      },
      "patterns": [
        {
          "name": "variable.parameter.jade",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "comment": "module-path separator — use std::math, from std::math use floor, @tools::register",
          "name": "keyword.operator.path.jade",
          "match": "::"
        },
        {
          "comment": "~> — jade-green like `prompt` and `?`. Must precede the bitwise and comparison rules so the ~ and > aren't tokenized separately.",
          "name": "keyword.other.prompt.jade",
          "match": "~>"
        },
        {
          "name": "keyword.operator.pipe.jade",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.logical.jade",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.jade",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.jade",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.jade",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.jade",
          "match": "(?<![=!<>])=(?!=)"
        }
      ]
    }
  }
}
